<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/welcomeRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/sp_background" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingHorizontal="24dp" android:paddingTop="20dp" android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold" android:text="studypath."
            android:textSize="24sp" android:textColor="@color/sp_ink"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:orientation="horizontal"
            android:layout_marginTop="24dp" android:contentDescription="Welcome, step 1 of 2">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/sp_ink"/>
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@color/sp_outline"/>
        </LinearLayout>
        <com.studypath.app.ui.GiraffeMascotView android:id="@+id/mascot"
            android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="20dp"
            android:importantForAccessibility="no" android:contentDescription="@null"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.StudyPath.Auth.Heading" android:fontFamily="@font/nunito_bold" android:textStyle="bold" android:gravity="center"
            android:text="A little learning.\nEvery day." android:textSize="38sp" android:accessibilityHeading="true"/>
        <com.studypath.app.ui.StudyButton android:id="@+id/demoButton" style="@style/Widget.StudyPath.Auth.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Try the student demo"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5 subjects · no account needed" android:gravity="center" android:textColor="@color/sp_muted" android:textSize="14sp"/>
        <com.studypath.app.ui.StudyButton android:id="@+id/signUpButton"
            style="@style/Widget.StudyPath.Auth.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="Get started"/>
        <com.studypath.app.ui.StudyButton android:id="@+id/loginButton"
            style="@style/Widget.StudyPath.Auth.Link" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="I already have an account"/>
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:contentDescription="Opening your account" android:indeterminate="true" android:visibility="gone"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:fontFamily="@font/geist"
            android:textColor="@color/sp_ink" android:textSize="14sp" android:visibility="gone"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
