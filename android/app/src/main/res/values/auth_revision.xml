<resources>
    <style name="Widget.StudyPath.Auth.Primary" parent="Widget.StudyPath.Button">
        <item name="android:minHeight">56dp</item><item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/nunito_bold</item><item name="fontFamily">@font/nunito_bold</item>
        <item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item><item name="backgroundTint">@color/button_fill</item>
        <item name="android:textColor">@color/button_text</item><item name="strokeWidth">0dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">4dp</item>
    </style>
    <style name="Widget.StudyPath.Auth.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item><item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/geist</item><item name="fontFamily">@font/geist</item>
        <item name="android:textAllCaps">false</item><item name="android:textColor">@color/sp_ink</item>
        <item name="cornerRadius">100dp</item>
    </style>
    <style name="Widget.StudyPath.Auth.Back" parent="Widget.StudyPath.Auth.Link">
        <item name="android:minWidth">48dp</item><item name="android:textSize">24sp</item>
        <item name="android:padding">0dp</item><item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item><item name="backgroundTint">#FFFFFF</item>
    </style>
    <style name="Widget.StudyPath.Auth.Field" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">#FFFFFF</item><item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item><item name="boxStrokeColor">@color/sp_ink</item>
        <item name="boxCornerRadiusTopStart">20dp</item><item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item><item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="hintTextColor">@color/sp_ink</item><item name="android:textColorHint">@color/sp_muted</item>
    </style>
    <style name="TextAppearance.StudyPath.Auth.Heading" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/nunito_bold</item><item name="fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">36sp</item><item name="android:textColor">@color/sp_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
