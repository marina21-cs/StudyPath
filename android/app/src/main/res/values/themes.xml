<resources>
    <style name="Theme.StudyPath" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sp_action</item><item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/sp_blue</item><item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/sp_card</item><item name="colorSurfaceVariant">@color/sp_background</item>
        <item name="colorOnSurface">@color/sp_ink</item><item name="colorOnSurfaceVariant">@color/sp_ink</item>
        <item name="colorOutline">@color/sp_outline</item><item name="colorError">#B3261E</item>
        <item name="android:colorBackground">@color/sp_background</item>
        <item name="android:fontFamily">@font/geist</item>
        <item name="android:windowLightStatusBar">true</item><item name="android:windowLightNavigationBar">true</item><item name="android:navigationBarColor">@color/sp_background</item>
        <item name="materialButtonStyle">@style/Widget.StudyPath.Button</item>
        <item name="textInputStyle">@style/Widget.StudyPath.Input</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.StudyPath.Card</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.StudyPath.Card</item>
    </style>
    <style name="Widget.StudyPath.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item><item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/nunito_bold</item><item name="fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">16sp</item><item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/button_fill</item><item name="android:textColor">@color/button_text</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">4dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.StudyPath.Input" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/sp_card</item><item name="boxStrokeColor">@color/sp_muted</item><item name="boxCornerRadiusTopStart">16dp</item><item name="boxCornerRadiusTopEnd">16dp</item><item name="boxCornerRadiusBottomStart">16dp</item><item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/sp_ink</item>
    </style>
    <style name="ShapeAppearance.StudyPath.Card" parent="ShapeAppearance.Material3.Corner.Medium"><item name="cornerSize">24dp</item></style>
    <style name="Widget.StudyPath.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator"><item name="android:color">@color/sp_background</item></style>
    <style name="TextAppearance.StudyPath.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/nunito_bold</item><item name="fontFamily">@font/nunito_bold</item>
        <item name="android:textSize">20sp</item><item name="android:textColor">@color/sp_ink</item>
    </style>
</resources>
